# Copy to .env next to simulation.py; simulation.py loads it on start.

# POST /market_results endpoint of the BRP; leave empty to send nothing
BRP_MARKET_RESULTS_URL=https://mas4te.nowum.fh-aachen.de/brp-api/market_results

# MARKET_RESULTS_PASSWORD of the BRP (not the password of the agents), username is "assume"
MARKET_RESULTS_PASSWORD=change-me
